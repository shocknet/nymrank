PORT=3333

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nymrank
DB_USER=nymrank_user
DB_PASSWORD=nymrank_password
# Optional pool tuning (production: dedicated LISTEN + retries on stale connections)
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=60000
# DB_MAX_LIFETIME_SECONDS=1800
# DB_LISTEN_KEEPALIVE_MS=60000

# BXRD WoT attestor (primary data source)
BXRD_API_BASE_URL=https://bxrd.app/api
BXRD_ATTESTOR_BEARER_TOKEN=nymrank-attestor-secret
BXRD_SYNC_ENABLED=true
BXRD_SYNC_ON_START=true
BXRD_DELTA_POLL_MS=30000
BXRD_DISABLE_RELAYS=true
BXRD_PRIMARY_SOURCE=true
BXRD_SYNC_MODE=upsert
# HEALTH_MIN_BXRD_RANKINGS=1000
# Optional gate for /bxrd-stats (unlisted ops page)
# BXRD_STATS_KEY=your-secret

# Legacy relay ingest (disabled when BXRD_DISABLE_RELAYS=true)
RANKING_RELAY_URLS=wss://nip85.brainstorm.world
SOCIAL_RELAY_URLS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.primal.net,wss://nostrue.com,wss://nostr-pub.wellorder.net,wss://nostr.bitcoiner.social
